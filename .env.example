# Replace the key and select an Anthropic model available to your account.
ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_MODEL=claude-sonnet-5
CONTEXT_WINDOW=200000
COMPACT_RATIO=0.8
COMPACTION_OUTPUT_TOKENS=4096
MAX_TOOL_CHARS=12000
MAX_ROUNDS=30

MAX_BACKGROUND_TASKS=5
MAX_WAKEUP_SECONDS=86400
